{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowJs": true,
    "allowImportingTsExtensions": true,
    "types": ["node"]
  },
  "include": ["index.ts", "rpc.ts", "tui.ts", "lib/options.mjs", "lib/alerts.mjs", "lib/present.mjs", "lib/schedule.mjs", "cli.mjs"]
}
